# App
PUBLIC_APP_URL=http://localhost:8080

# TiDB Cloud (MySQL protocol, TLS)
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=quicksanta
DB_SSL=true

# Resend (OTP + invitations). Without a key, emails are logged (dry run).
RESEND_API_KEY=
SMTP_FROM="QuickSanta <hello@example.com>"

# Stripe (Pro: $8.90/month per workspace subscription). Use test keys locally (sk_test_… / pk_test_…).
# STRIPE_PUBLISHABLE_KEY is accepted as an alias of VITE_STRIPE_PUBLISHABLE_KEY.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_PLATFORM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=

# Deploy helpers (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEPLOY_NAME=QuickSanta
SLACK_BOT_TOKEN=
SLACK_RELEASES_CHANNEL_ID=
ANTHROPIC_API_KEY=
