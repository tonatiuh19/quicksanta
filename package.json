{
  "name": "quicksanta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run --project unit --project ui",
    "test:unit": "vitest --run --project unit",
    "test:ui": "vitest --run --project ui",
    "test:integration": "vitest --run --project integration",
    "test:all": "vitest --run",
    "test:watch": "vitest --project unit --project ui",
    "typecheck": "tsc",
    "check:api-inline": "npx tsx scripts/check-api-inline.ts",
    "deploy:prod": "npx tsx scripts/deploy-prod.ts",
    "deploy:stamp-version": "npx tsx scripts/deploy-prod.ts --stamp-only",
    "db:migrate": "bash scripts/apply-migrations.sh",
    "test:cleanup-fixtures": "npx tsx scripts/cleanup-test-fixtures.ts",
    "format.fix": "prettier --write .",
    "e2e:stripe": "npx tsx scripts/stripe-e2e.ts",
    "e2e:browser": "playwright test",
    "audit:mobile": "playwright test e2e/mobile-audit.spec.ts --project mobile"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@reduxjs/toolkit": "^2.3.0",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.4.0",
    "@vercel/node": "^3.0.21",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.539.0",
    "mysql2": "^3.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.30.1",
    "resend": "^6.12.2",
    "stripe": "^23.2.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.21",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
